{
	"name": "retro-react",
	"version": "1.5.0",
	"type": "commonjs",
	"private": false,
	"description": "Authentic Windows 95/98 retro React UI library — 50+ typed, accessible components with bevels, sharp pixels, and CRT vibes.",
	"keywords": [
		"react",
		"react-component",
		"react-component-library",
		"react-library",
		"react-ui",
		"react-ui-library",
		"retro",
		"retro-react",
		"retro-style",
		"retro-ui",
		"retro-ui-library",
		"ui",
		"ui-library",
		"webcore"
	],
	"author": {
		"name": "Retro React",
		"url": "https://github.com/retro-react"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/retro-react/retro-react.git"
	},
	"bugs": {
		"url": "https://github.com/retro-react/retro-react/issues"
	},
	"homepage": "https://retro-react.github.io/retro-react",
	"license": "MIT",
	"sideEffects": false,
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"main": "dist/index.js",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup && tsc -p tsconfig.build.json && cp dist/index.d.ts dist/index.d.mts",
		"build:storybook": "storybook build -o docs-build",
		"changeset": "changeset",
		"lint": "eslint src --ext .ts,.tsx",
		"prepare": "husky install",
		"prepublishOnly": "npm run build",
		"release": "changeset publish",
		"storybook": "NODE_ENV=development storybook dev -p 6006 --quiet",
		"test": "NODE_ENV=test jest --passWithNoTests",
		"test:coverage": "NODE_ENV=test jest --coverage",
		"test:watch": "NODE_ENV=test jest --watch",
		"format": "prettier **/*.tsx --write",
		"pre-commit": "lint-staged"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{md,mdx,yml,json}": [
			"prettier --write"
		]
	},
	"browserslist": [
		"> 1%",
		"not dead",
		"not edge <= 18",
		"not ie 11",
		"not op_mini all"
	],
	"dependencies": {
		"@babel/runtime": "^7.21.0",
		"@emotion/react": "^11.0.0",
		"@emotion/styled": "^11.0.0",
		"theme-ui": "^0.15.7"
	},
	"devDependencies": {
		"@babel/core": "^7.21.4",
		"@babel/plugin-transform-runtime": "^7.21.4",
		"@babel/preset-env": "^7.21.4",
		"@babel/preset-react": "^7.18.6",
		"@babel/preset-typescript": "^7.21.4",
		"@changesets/cli": "^2.26.1",
		"@commitlint/cli": "^17.6.1",
		"@commitlint/config-conventional": "^17.6.1",
		"@emotion/babel-plugin": "^11.10.6",
		"@emotion/react": "^11.10.6",
		"@emotion/styled": "^11.10.6",
		"@mdx-js/react": "^2.3.0",
		"@storybook/addon-a11y": "^7.0.7",
		"@storybook/addon-actions": "^7.0.7",
		"@storybook/addon-essentials": "^7.0.7",
		"@storybook/addon-interactions": "^7.0.7",
		"@storybook/addon-links": "^7.0.7",
		"@storybook/addon-mdx-gfm": "^7.0.7",
		"@storybook/react": "^7.0.7",
		"@storybook/react-webpack5": "^7.0.7",
		"@storybook/testing-library": "^0.1.0",
		"@testing-library/jest-dom": "^5.16.5",
		"@testing-library/react": "^14.0.0",
		"@testing-library/user-event": "^14.4.3",
		"@trivago/prettier-plugin-sort-imports": "^4.1.1",
		"@types/jest": "^29.5.1",
		"@types/node": "^18.16.1",
		"@types/react": "~18.2.0",
		"@types/react-dom": "~18.2.0",
		"@types/testing-library__jest-dom": "^5.14.5",
		"@typescript-eslint/eslint-plugin": "^5.59.1",
		"@typescript-eslint/parser": "^5.59.1",
		"babel-loader": "^9.1.2",
		"eslint": "8.39.0",
		"eslint-config-prettier": "^8.8.0",
		"eslint-plugin-jsx-a11y": "^6.7.1",
		"eslint-plugin-prettier": "^4.2.1",
		"eslint-plugin-react": "^7.32.2",
		"eslint-plugin-react-hooks": "^4.6.0",
		"eslint-plugin-storybook": "^0.6.11",
		"eslint-plugin-testing-library": "^5.10.3",
		"husky": "^8.0.3",
		"jest": "^29.5.0",
		"jest-environment-jsdom": "^29.5.0",
		"jest-transform-stub": "^2.0.0",
		"lint-staged": "^13.2.2",
		"prettier": "^2.8.8",
		"publint": "^0.3.21",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"storybook": "^7.0.7",
		"ts-jest": "^29.1.0",
		"tsup": "^8.5.1",
		"typescript": "^4.9.5",
		"webpack": "^5.81.0",
		"webpack-cli": "^5.0.2"
	},
	"peerDependencies": {
		"react": "^16.8.0 || ^17 || ^18 || ^19",
		"react-dom": "^16.8.0 || ^17 || ^18 || ^19"
	},
	"engines": {
		"node": ">=18"
	}
}
