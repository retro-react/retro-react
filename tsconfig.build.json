{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"declaration": true,
		"emitDeclarationOnly": true,
		"outDir": "dist",
		"noEmit": false
	},
	"include": ["src/**/*"],
	"exclude": [
		"node_modules",
		"src/**/__stories__",
		"src/**/__tests__",
		"src/**/*.stories.tsx",
		"src/**/*.stories.mdx",
		"src/documentation"
	]
}
